{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZoolandingIntegrationBindings",
  "type": "object",
  "required": ["version", "scope", "adminAccess", "bindings"],
  "properties": {
    "version": { "const": 1 },
    "scope": { "$ref": "#/definitions/scope" },
    "adminAccess": {
      "oneOf": [
        { "$ref": "#/definitions/noAdminAccess" },
        { "$ref": "#/definitions/authProfileAccess" }
      ]
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/definitions/binding" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "domain": {
      "type": "string",
      "minLength": 4,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "integrationCapability": {
      "enum": [
        "integration:read",
        "integration:manage"
      ]
    },
    "sameOriginPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^/(?!/)(?!.*[\\\\\\s?#:\\u0000-\\u001F\\u007F]).*$"
    },
    "scope": {
      "type": "object",
      "required": ["environment", "tenantId", "draftId", "domain"],
      "properties": {
        "environment": { "enum": ["test", "production"] },
        "tenantId": { "$ref": "#/definitions/safeId" },
        "draftId": { "$ref": "#/definitions/safeId" },
        "domain": { "$ref": "#/definitions/domain" }
      },
      "additionalProperties": false
    },
    "noAdminAccess": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "const": "none" }
      },
      "additionalProperties": false
    },
    "authProfileAccess": {
      "type": "object",
      "required": ["mode", "authProfileId", "capabilities"],
      "properties": {
        "mode": { "const": "auth-profile" },
        "authProfileId": { "$ref": "#/definitions/safeId" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/integrationCapability" }
        }
      },
      "additionalProperties": false
    },
    "onboardingRoutes": {
      "type": "object",
      "required": ["returnPath", "refreshPath"],
      "properties": {
        "returnPath": { "$ref": "#/definitions/sameOriginPath" },
        "refreshPath": { "$ref": "#/definitions/sameOriginPath" }
      },
      "additionalProperties": false
    },
    "stripeSettings": {
      "type": "object",
      "required": ["accountStrategy", "accountModel", "chargeType", "feePayer", "taxMode", "platformFeeMode", "webhookIngress"],
      "properties": {
        "accountStrategy": { "enum": ["oauth-standard-v1", "controller-account-link-v1"] },
        "accountModel": { "const": "merchant" },
        "chargeType": { "const": "direct" },
        "feePayer": { "const": "connected-account" },
        "taxMode": { "enum": ["unconfigured", "manual-rate", "stripe-tax"] },
        "taxApprovalId": { "$ref": "#/definitions/safeId" },
        "platformFeeMode": { "enum": ["disabled", "application-fee"] },
        "webhookIngress": { "const": "direct-integrations-api" },
        "onboardingRoutes": { "$ref": "#/definitions/onboardingRoutes" }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["id", "provider", "adapterVersion", "connectionId", "status", "mode", "capabilities"],
      "properties": {
        "id": { "$ref": "#/definitions/safeId" },
        "provider": { "$ref": "#/definitions/safeId" },
        "adapterVersion": { "$ref": "#/definitions/safeId" },
        "connectionId": { "$ref": "#/definitions/safeId" },
        "status": { "enum": ["disabled", "active"] },
        "mode": { "enum": ["test", "live"] },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/safeId" }
        },
        "stripe": { "$ref": "#/definitions/stripeSettings" }
      },
      "additionalProperties": false
    }
  }
}
